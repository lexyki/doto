public class Здібність
{
    public string Назва { get; set; }
    public double ВартістьМани { get; set; }
    public double Шкода { get; set; }
    public double Лікування { get; set; }
    public string Ефект { get; set; }
    
    public Здібність(string назва, double вартістьМани, double шкода = 0, double лікування = 0, string ефект = null)
    {
        Назва = назва;
        ВартістьМани = вартістьМани;
        Шкода = шкода;
        Лікування = лікування;
        Ефект = ефект;
    }
    
    public void Використати(Персонаж персонаж, Персонаж ціль = null)
    {
        Console.WriteLine($"{персонаж.Імя} використовує '{Назва}'!");
        
        if (ціль != null && Шкода > 0)
        {
            ціль.Здоровя -= Шкода;
            Console.WriteLine($"{ціль.Імя} отримує {Шкода} шкоди від '{Назва}'!");
            
            if (ціль.Здоровя <= 0)
            {
                ціль.Здоровя = 0;
                ціль.Живий = false;
                Console.WriteLine($"{ціль.Імя} помер!");
            }
        }
        
        if (Ефект != null && ціль != null)
        {
            Console.WriteLine($"{ціль.Імя} отримує ефект: {Ефект}");
        }
        
        if (Лікування > 0)
        {
            персонаж.Здоровя += Лікування;
            Console.WriteLine($"{персонаж.Імя} відновлює {Лікування} здоров'я!");
        }
    }
}
