using System;
using System.Collections.Generic;
using System.Linq;

// Спочатку визначаємо клас Здібність, оскільки він використовується в класі Персонаж
public class Здібність
{
    public string Назва { get; set; }
    public double ВартістьМани { get; set; }
    public double Шкода { get; set; }
    public double Лікування { get; set; }
    public string Ефект { get; set; }

    public Здібність(string назва, double вартістьМани, double шкода = 0, double лікування = 0, string ефект = null)
    {
        Назва = назва;
        ВартістьМани = вартістьМани;
        Шкода = шкода;
        Лікування = лікування;
        Ефект = ефект;
    }

    public void Використати(Персонаж персонаж, Персонаж ціль = null)
    {
        Console.WriteLine($"{персонаж.Імя} використовує '{Назва}'!");

        if (ціль != null && Шкода > 0)
        {
            ціль.Здоровя -= Шкода;
            Console.WriteLine($"{ціль.Імя} отримує {Шкода} шкоди від '{Назва}'!");

            if (ціль.Здоровя <= 0)
            {
                ціль.Здоровя = 0;
                ціль.Живий = false;
                Console.WriteLine($"{ціль.Імя} помер!");
            }
        }

        if (Ефект != null && ціль != null)
        {
            Console.WriteLine($"{ціль.Імя} отримує ефект: {Ефект}");
        }

        if (Лікування > 0)
        {
            персонаж.Здоровя += Лікування;
            Console.WriteLine($"{персонаж.Імя} відновлює {Лікування} здоров'я!");
        }
    }
}

// Потім клас Предмет
public class Предмет
{
    public string Назва { get; set; }
    public int Вартість { get; set; }
    public double БонусУрону { get; set; }
    public double БонусБроні { get; set; }
    public double БонусЗдоровя { get; set; }
    public double БонусМани { get; set; }

    public Предмет(string назва, int вартість, double бонусУрону = 0, double бонусБроні = 0,
                   double бонусЗдоровя = 0, double бонусМани = 0)
    {
        Назва = назва;
        Вартість = вартість;
        БонусУрону = бонусУрону;
        БонусБроні = бонусБроні;
        БонусЗдоровя = бонусЗдоровя;
        БонусМани = бонусМани;
    }

    public void Екіпірувати(Персонаж персонаж)
    {
        персонаж.Урон += БонусУрону;
        персонаж.Броня += БонусБроні;
        персонаж.Здоровя += БонусЗдоровя;
        персонаж.Мана += БонусМани;

        Console.WriteLine($"{персонаж.Імя} екіпірував {Назва}!");
        Console.WriteLine($"Бонус: +{БонусУрону} урону, +{БонусБроні}% броні, " +
                         $"+{БонусЗдоровя} здоров'я, +{БонусМани} мани");
    }
}

// Тепер клас Персонаж, який використовує попередні класи
public class Персонаж
{
    public string Імя { get; set; }
    public double Здоровя { get; set; }
    public double Мана { get; set; }
    public double Урон { get; set; }
    public double Броня { get; set; }
    public bool Живий { get; set; }
    public List<Здібність> Здібності { get; set; }

    public Персонаж(string імя, double здоровя, double мана, double урон, double броня)
    {
        Імя = імя;
        Здоровя = здоровя;
        Мана = мана;
        Урон = урон;
        Броня = броня;
        Живий = true;
        Здібності = new List<Здібність>();
    }

    public void ДодатиЗдібність(Здібність здібність)
    {
        Здібності.Add(здібність);
        Console.WriteLine($"{Імя} вивчив здібність: {здібність.Назва}");
    }

    public void Атакувати(Персонаж ціль)
    {
        if (!Живий)
        {
            Console.WriteLine($"{Імя} не може атакувати, бо неживий!");
            return;
        }

        if (!ціль.Живий)
        {
            Console.WriteLine($"{ціль.Імя} вже неживий!");
            return;
        }

        double реальнийУрон = Урон * (1 - ціль.Броня / 100);
        ціль.Здоровя -= реальнийУрон;

        Console.WriteLine($"{Імя} атакує {ціль.Імя} і завдає {реальнийУрон:F1} шкоди!");

        if (ціль.Здоровя <= 0)
        {
            ціль.Здоровя = 0;
            ціль.Живий = false;
            Console.WriteLine($"{ціль.Імя} вибуває з гри!");
        }
    }

    public void ВикористатиЗдібність(string назваЗдібності, Персонаж ціль = null)
    {
        if (!Живий)
        {
            Console.WriteLine($"{Імя} не може використовувати здібності!");
            return;
        }

        Здібність здібність = Здібності.Find(z => z.Назва == назваЗдібності);

        if (здібність == null)
        {
            Console.WriteLine($"{Імя} не знає здібність '{назваЗдібності}'!");
            return;
        }

        if (Мана < здібність.ВартістьМани)
        {
            Console.WriteLine($"{Імя} не має достатньо мани для '{назваЗдібності}'!");
            return;
        }

        Мана -= здібність.ВартістьМани;

        if (ціль != null)
        {
            здібність.Використати(this, ціль);
        }
        else
        {
            здібність.Використати(this);
        }
    }

    public string ОтриматиСтатус()
    {
        string статус = $"{Імя}: HP={Здоровя:F1}, MP={Мана:F1}, Урон={Урон}, Броня={Броня}%";
        if (!Живий) статус += " [НЕЖИВИЙ]";
        return статус;
    }

    internal void Екіпірувати(Предмет меч)
    {
        throw new NotImplementedException();
    }
}

// І нарешті головний клас програми
public class Програма
{
    public static void КоманднийБій(List<Персонаж> команда1, List<Персонаж> команда2)
    {
        Console.WriteLine("\n=== ПОЧИНАЄТЬСЯ КОМАНДНИЙ БІЙ ===");

        Random випадковий = new Random();

        foreach (var атакуючий in команда1)
        {
            if (атакуючий.Живий)
            {
                var живіЦілі = команда2.Where(ц => ц.Живий).ToList();
                if (живіЦілі.Count > 0)
                {
                    var ціль = живіЦілі[випадковий.Next(живіЦілі.Count)];
                    атакуючий.Атакувати(ціль);
                }
            }
        }

        foreach (var атакуючий in команда2)
        {
            if (атакуючий.Живий)
            {
                var живіЦілі = команда1.Where(ц => ц.Живий).ToList();
                if (живіЦілі.Count > 0)
                {
                    var ціль = живіЦілі[випадковий.Next(живіЦілі.Count)];
                    атакуючий.Атакувати(ціль);
                }
            }
        }

        Console.WriteLine("\n=== СТАН КОМАНД ПІСЛЯ БОЮ ===");
        Console.WriteLine("Команда 1:");
        foreach (var герой in команда1)
        {
            Console.WriteLine($"  {герой.ОтриматиСтатус()}");
        }

        Console.WriteLine("Команда 2:");
        foreach (var герой in команда2)
        {
            Console.WriteLine($"  {герой.ОтриматиСтатус()}");
        }
    }

    public static void МасовеВикористання(Персонаж чаклун, string назваЗдібності, List<Персонаж> команда)
    {
        Console.WriteLine($"\n{чаклун.Імя} використовує '{назваЗдібності}' на команду!");

        foreach (var ціль in команда)
        {
            if (ціль.Живий)
            {
                чаклун.ВикористатиЗдібність(назваЗдібності, ціль);
            }
        }
    }

    public static void Main(string[] args)
    {
        Console.WriteLine("=== СИМУЛЯЦІЯ ІГРОВОЇ СИСТЕМИ ===\n");

        // Створення персонажів
        var воїн = new Персонаж("Воїн", 800, 300, 65, 15);
        var маг = new Персонаж("Маг", 500, 600, 45, 5);
        var лучник = new Персонаж("Лучник", 600, 400, 70, 8);

        // Створення здібностей
        var вогнянаКуля = new Здібність("Вогняна куля", 50, шкода: 80);
        var цілющаЕнергія = new Здібність("Цілюща енергія", 30, лікування: 60);
        var морознийПоцілунок = new Здібність("Морозний поцілунок", 40, шкода: 60, ефект: "сповільнення");

        // Створення предметів
        var меч = new Предмет("Меч воїна", 500, бонусУрону: 15);
        var щит = new Предмет("Міцний щит", 300, бонусБроні: 10, бонусЗдоровя: 50);
        var мантії = new Предмет("Мантії мага", 400, бонусМани: 100);

        // Навчання здібностей
        маг.ДодатиЗдібність(вогнянаКуля);
        маг.ДодатиЗдібність(морознийПоцілунок);
        воїн.ДодатиЗдібність(цілющаЕнергія);

        // Екіпірування предметів
        воїн.Екіпірувати(меч);
        воїн.Екіпірувати(щит);
        маг.Екіпірувати(мантії);

        Console.WriteLine("\n--- Демонстрація атак ---");
        воїн.Атакувати(лучник);
        маг.ВикористатиЗдібність("Вогняна куля", лучник);

        Console.WriteLine("\n--- Стан персонажів ---");
        Console.WriteLine(воїн.ОтриматиСтатус());
        Console.WriteLine(маг.ОтриматиСтатус());
        Console.WriteLine(лучник.ОтриматиСтатус());

        // Створення команд для бою
        var команда1 = new List<Персонаж> { воїн, маг };
        var команда2 = new List<Персонаж>
        {
            new Персонаж("Ворог 1", 400, 200, 55, 10),
            new Персонаж("Ворог 2", 450, 250, 60, 8),
            new Персонаж("Ворог 3", 500, 300, 50, 12)
        };

        // Командний бій
        КоманднийБій(команда1, команда2);

        Console.WriteLine("\n=== СИМУЛЯЦІЯ ЗАВЕРШЕНА ===");
        Console.ReadLine(); // Щоб консоль не закривалася відразу
    }
}
